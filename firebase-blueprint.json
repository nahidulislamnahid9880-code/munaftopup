        "eventType": { "type": "string", "enum": ["referral_bonus", "loyalty_earn", "loyalty_redeem"] },
        "orderNumber": { "type": "string", "maxLength": 32 },
        "walletDelta": { "type": "number" },
        "pointsDelta": { "type": "number" },
        "note": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "referrerUid", "referredUid", "eventType", "walletDelta", "pointsDelta", "createdAt"]
    }
  },
